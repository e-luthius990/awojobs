{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": "./src",
    "paths": {
      "@hooks/*": ["hooks/*"],
      "@ui/*": ["ui/*"],
      "@screens/*": ["screens/*"],
      "@core/*": ["core/*"],
      "@jobs/*": ["jobs/*"],
      "@location/*": ["location/*"],
      "@navigation/*": ["navigation/*"],
      "@state/*": ["state/*"],
      "@utils/*": ["utils/*"]
    }
  }
}
